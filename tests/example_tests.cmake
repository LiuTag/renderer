# 源码工程与已安装 SDK 共用的示例运行检查；测试入口统一保存在 tests/。
include_guard(GLOBAL)

function(renderer_add_example_check name target)
    if(NOT TARGET ${target})
        return()
    endif()
    get_target_property(needs_gl ${target} RENDERER_EXAMPLE_REQUIRES_OPENGL)
    get_target_property(needs_vk ${target} RENDERER_EXAMPLE_REQUIRES_VULKAN)
    if(needs_vk AND NOT RENDERER_VULKAN_TESTS)
        return()
    endif()
    if(needs_gl AND NOT RENDERER_GL_TESTS)
        return()
    endif()
    add_test(NAME ${name} COMMAND ${target} ${ARGN})
    if(needs_vk)
        set_tests_properties(${name} PROPERTIES TIMEOUT 120 LABELS "gpu;vulkan;example")
    elseif(needs_gl)
        set_tests_properties(${name} PROPERTIES TIMEOUT 60 LABELS "gpu;example")
    else()
        set_tests_properties(${name} PROPERTIES TIMEOUT 60 LABELS "cpu;example")
    endif()
endfunction()

function(renderer_register_example_tests)
    if(NOT RENDERER_BUILD_TESTS)
        return()
    endif()
    if(TARGET renderer_performance)
        foreach(backend IN ITEMS opengl vulkan)
            if((backend STREQUAL "opengl" AND RENDERER_GL_TESTS AND WIN32 AND TARGET renderer::opengl) OR
               (backend STREQUAL "vulkan" AND RENDERER_VULKAN_TESTS AND TARGET renderer::vulkan))
                add_test(NAME renderer.performance.${backend} COMMAND renderer_performance
                    --backend ${backend} --threads all --workload all --count 500 --warmup 3 --frames 12
                    --self-test --csv "${CMAKE_BINARY_DIR}/performance-${backend}.csv")
                set_tests_properties(renderer.performance.${backend} PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE LABELS "gpu;example;performance;${backend}")
            endif()
        endforeach()
    endif()
    if(TARGET renderer_text_demo)
        foreach(backend IN ITEMS opengl vulkan)
            if((backend STREQUAL "opengl" AND RENDERER_GL_TESTS AND TARGET renderer::opengl) OR
               (backend STREQUAL "vulkan" AND RENDERER_VULKAN_TESTS AND TARGET renderer::vulkan))
                foreach(mode IN ITEMS window offscreen)
                    if(mode STREQUAL "offscreen" AND backend STREQUAL "opengl" AND NOT WIN32)
                        continue()
                    endif()
                    if(mode STREQUAL "window")
                        set(text_args --hidden --threaded)
                    else()
                        set(text_args --offscreen --single-thread)
                    endif()
                    add_test(NAME renderer.text.${backend}.${mode}.example COMMAND renderer_text_demo
                        --backend ${backend} ${text_args} --frames 36 --self-test --output "${CMAKE_BINARY_DIR}/text-${backend}-${mode}.png")
                    set_tests_properties(renderer.text.${backend}.${mode}.example PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE LABELS "gpu;text;example;${backend}")
                endforeach()
            endif()
        endforeach()
    endif()
    if(TARGET renderer_ui_demo)
        foreach(backend IN ITEMS opengl vulkan)
            if((backend STREQUAL "opengl" AND RENDERER_GL_TESTS AND TARGET renderer::opengl) OR
               (backend STREQUAL "vulkan" AND RENDERER_VULKAN_TESTS AND TARGET renderer::vulkan))
                foreach(mode IN ITEMS window offscreen)
