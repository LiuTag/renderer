                        --backend ${backend} ${ui_args} --frames 36 --self-test --output "${CMAKE_BINARY_DIR}/ui-${backend}-${mode}.png")
                    set_tests_properties(renderer.ui.${backend}.${mode}.example PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE LABELS "gpu;ui;example;${backend}")
                endforeach()
            endif()
        endforeach()
    endif()
    if(TARGET renderer_texture_pack)
        add_test(NAME renderer.texture.pack COMMAND renderer_texture_pack --self-test
            --output "${CMAKE_BINARY_DIR}/texture-tool/array.dds")
        set_tests_properties(renderer.texture.pack PROPERTIES TIMEOUT 30 LABELS "cpu;example;texture")
    endif()
    if(TARGET renderer_texture_text_demo)
        foreach(backend IN ITEMS opengl vulkan)
