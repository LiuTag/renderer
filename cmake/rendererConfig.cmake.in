@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/rendererTargets.cmake")
set(renderer_EXAMPLE_TEST_HELPER "@PACKAGE_CMAKE_INSTALL_DATADIR@/renderer/tests/example_tests.cmake")

set(renderer_core_FOUND TRUE)
set(renderer_opengl_FOUND @RENDERER_BUILD_OPENGL@)
set(renderer_vulkan_FOUND @RENDERER_BUILD_VULKAN@)
set(renderer_animation_FOUND @RENDERER_BUILD_ANIMATION@)
set(renderer_interaction_FOUND @RENDERER_BUILD_INTERACTION@)
set(renderer_audio_FOUND @RENDERER_BUILD_AUDIO@)
set(renderer_tilemap_FOUND @RENDERER_BUILD_TILEMAP@)
set(renderer_collision_FOUND @RENDERER_BUILD_COLLISION@)
set(renderer_particles_FOUND @RENDERER_BUILD_PARTICLES@)
set(renderer_environment_FOUND @RENDERER_BUILD_ENVIRONMENT@)
set(renderer_presentation_FOUND @RENDERER_BUILD_PRESENTATION@)
set(renderer_physics2d_FOUND @RENDERER_BUILD_PHYSICS2D@)
set(renderer_camera_FOUND @RENDERER_BUILD_CAMERA@)
set(renderer_ui_FOUND @RENDERER_BUILD_UI@)
set(renderer_text_FOUND @RENDERER_BUILD_TEXT@)
if(renderer_text_FOUND)
    set(renderer_TEXT_FONT "@PACKAGE_CMAKE_INSTALL_DATADIR@/renderer/assets/LatoLatin-Regular.ttf")
endif()
if(renderer_ui_FOUND)
    set(renderer_UI_FONT "@PACKAGE_CMAKE_INSTALL_DATADIR@/renderer/assets/LatoLatin-Regular.ttf")
endif()
check_required_components(renderer)
